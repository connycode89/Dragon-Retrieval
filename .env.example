# Anthropic Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_key_here

# Dúchas API key — email eolas@duchas.ie to request one
DUCHAS_API_KEY=your_key_here

# Logainm API key — register at gaois.ie or email logainm@dcu.ie
LOGAINM_API_KEY=your_key_here

# Optional: path to persist the Chroma vector database (default: ./chroma_db)
# CHROMA_PERSIST_DIR=./chroma_db

# Optional: HuggingFace model for embeddings (default: sentence-transformers/all-MiniLM-L6-v2)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: Claude model to use (default: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6
